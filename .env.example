# ─── Base de datos (obligatorio) ──────────────────────────────────────────────
# Conexión PostgreSQL usada por lib/db.ts (consultas y rate limiting).
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/nombre_base_de_datos

# ─── Backend interno de HomeLab (obligatorio para reservas e informes) ────────
# API que expone /reservas/publicas y /public/resultados/pdf.
# En producción usa la URL real, por ejemplo https://api.tudominio.com/api
HOMELAB_API_URL=http://localhost:3001/api
# Alternativa pública (solo si el cliente también debe conocerla).
# NEXT_PUBLIC_HOMELAB_API_URL=

# ─── RENIEC (autocompletado de DNI) ───────────────────────────────────────────
# Si no se configura, la API responde 501 y el usuario escribe el nombre a mano.
# Usa {dni} donde corresponda o deja la URL base y se añadirá /<dni>.
RENIEC_API_URL=
RENIEC_API_TOKEN=
# Esquema de autenticación: Bearer, Token, etc.
RENIEC_API_AUTH_SCHEME=Bearer

# ─── Sitio público (SEO) ──────────────────────────────────────────────────────
# Dominio real sin barra final. Se usa en metadata, sitemap y robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
